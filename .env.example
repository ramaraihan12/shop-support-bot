# Postgres with the pgvector extension available
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shop_support

# Chat model: ollama (default, free), openai, google or anthropic
AI_PROVIDER=ollama
# Leave empty to use the provider default (qwen3.5:9b for Ollama)
AI_MODEL=

# Embeddings: ollama, openai or google. Vectors are stored at 1024 dims,
# so changing this means running `pnpm ingest` again.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=

OLLAMA_BASE_URL=http://localhost:11434/api

# Only needed for the matching provider
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Telegram bot (optional). See README for the webhook setup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Basic auth for /admin. Admin is disabled while the password is empty.
ADMIN_USER=admin
ADMIN_PASSWORD=
